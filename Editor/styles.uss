/* Root: accent is defined once and inherited by all children */
.stats-window {
    background-color: var(--unity-colors-window-background);
    --accent-color: #480085;
}

/* Tab bar: follows the editor toolbar so it matches dark and light themes */
.tab-bar {
    flex-direction: row;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
    padding: 4px 4px 0 4px;
}

.tab-button {
    flex-grow: 0;
    margin: 0 1px 0 0;
    padding: 5px 14px 4px 14px;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    border-radius: 0;
    background-color: transparent;
    color: var(--unity-colors-default-text);
    -unity-font-style: normal;
    opacity: 0.7;
}

.tab-button:hover {
    background-color: var(--unity-colors-tab-background-hover);
    opacity: 1;
}

/* Active tab: reads as part of the content pane, accent underline only */
.tab-button--active {
    background-color: var(--unity-colors-window-background);
    border-bottom-color: var(--accent-color);
    -unity-font-style: bold;
    opacity: 1;
}

/* Keep Unity's default button focus/press colors from overriding the tabs */
.tab-button:focus,
.tab-button:active,
.tab-button--active:focus,
.tab-button--active:active {
    color: var(--unity-colors-default-text);
}

.tab-content {
    flex-grow: 1;
    background-color: var(--unity-colors-window-background);
}

.stats-root {
    padding: 12px 12px 4px 12px;
}

/* Section header: muted caps with a hairline, no accent */
.section-title {
    margin: 10px 0 8px 0;
    padding: 0 0 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
    opacity: 0.65;
}

/* Grid: cards wrap and grow to fill each row; negative margin cancels the last card gap */
.stat-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: -6px;
}

.stat-card {
    flex-grow: 1;
    flex-basis: 130px;
    min-width: 130px;
    min-height: 52px;
    margin: 0 6px 6px 0;
    padding: 8px 10px;
    justify-content: center;
    border-radius: 3px;
    background-color: var(--unity-colors-box-background);
    border-width: 1px;
    border-color: var(--unity-colors-box-border);
    border-left-width: 3px;
    border-left-color: var(--accent-color);
}

.stat-value {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: var(--unity-colors-default-text);
}

.stat-label {
    margin-top: 2px;
    font-size: 10px;
    -unity-text-align: upper-left;
    white-space: normal;
    color: var(--unity-colors-default-text);
    opacity: 0.65;
}
